{
  "name": "wallet-rest-api",
  "version": "1.0.0",
  "private": true,
  "description": "Simple wallet REST API with background transfers",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
